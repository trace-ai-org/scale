    {
      "id": "scale:commons/10.1021-acs.chemrev.6c00095/claim/co2-not-bicarbonate",
      "label": "Claim",
      "props": {
        "name": "CO2, not bicarbonate, is the Fdh substrate",
        "claim_kind": "finding",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 13, Section 3.1",
            "quote": "Experimental evidence indicates that Fdh catalyzes the interconversion between CO2 and formate, rather than involving bicarbonate (HCO3 −) as a direct substrate or product",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          },
          {
            "kind": "text",
            "locator": "p. 13, Section 3.1",
            "quote": "In the oxidative direction, it has been established that Fdhs use formate as the sole substrate (Figure 14)",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          }
        ],
        "inference_type": "meta_analysis",
        "origin": "reported",
        "scope": "metal-dependent Fdhs, in vitro and in vivo",
        "statement": "Fdh catalyzes the interconversion between CO2 and formate directly: CO2, not bicarbonate, is the substrate of the reductive reaction, and formate the sole substrate of the oxidative reaction."
      }
    },
    {
      "id": "scale:commons/10.1021-acs.chemrev.6c00095/claim/iodoacetamide-unreliable",
      "label": "Claim",
      "props": {
        "name": "Iodoacetamide labeling is an unselective probe",
        "claim_kind": "finding",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 16, Section 3.4",
            "quote": "these results indicate that iodoacetamide labeling is unselective and therefore an unreliable probe for assessing the specific role of the active site Sec or Cys residue",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          }
        ],
        "inference_type": "meta_analysis",
        "origin": "reported",
        "scope": "metal-dependent Fdhs",
        "statement": "Iodoacetamide labeling is unselective and therefore an unreliable probe for assessing the specific role of the active-site Sec or Cys residue."
      }
    },
    {
      "id": "scale:commons/10.1021-acs.chemrev.6c00095/claim/reversible-electrocatalyst",
      "label": "Claim",
      "props": {
        "name": "Metal-dependent Fdhs are reversible electrocatalysts",
        "claim_kind": "conclusion",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 21, Section 5.1",
            "quote": "metal-dependent Fdhs are reversible electrocatalysts that showcases high electrocatalytic exchange currents and correspondingly, very minimal overpotential requirement in either direction",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          }
        ],
        "inference_type": "meta_analysis",
        "origin": "reported",
        "scope": "metal-dependent Fdhs on electrodes",
        "statement": "Metal-dependent Fdhs are reversible electrocatalysts: they show high electrocatalytic exchange currents and need very little overpotential in either direction."
      }
    },
    {
      "id": "scale:commons/10.1021-acs.chemrev.6c00095/claim/second-sphere-hydride",
      "label": "Claim",
      "props": {
        "name": "Second-sphere hydride-transfer consensus mechanism",
        "claim_kind": "mechanism",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 15, Section 3.3",
            "quote": "Current evidence supports a mechanism in which the Sec or Cys ligand remains coordinated to the metal, and CO2 is reduced to formate in the second coordination sphere, without direct binding of the substrate to the metal center",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          },
          {
            "kind": "text",
            "locator": "p. 15, Section 3.3",
            "quote": "the reduced active site, commonly presented in the protonated form as Mo(IV)-SH or W(IV)-SH, acts as a hydride donor to CO2, reducing it to formate in the second coordination sphere without direct substrate binding to the metal",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          }
        ],
        "inference_type": "meta_analysis",
        "origin": "reported",
        "scope": "metal-dependent Fdhs",
        "statement": "Consensus mechanism: the Sec or Cys ligand stays coordinated to the Mo/W center throughout catalysis, and CO2 is reduced to formate in the second coordination sphere by formal hydride transfer from the protonated terminal sulfur ligand (Mo(IV)-SH / W(IV)-SH), without direct substrate binding to the metal."
      }
    },
    {
      "id": "scale:commons/10.1021-acs.chemrev.6c00095/claim/shift-to-det",
      "label": "Claim",
      "props": {
        "name": "Field shift from mediated to direct electron transfer",
        "claim_kind": "conclusion",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 35, Section 7.3",
            "quote": "Four decades after the first MV-mediated semiartificial CO2 fixation using Fdh, research has clearly shifted toward DET",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          },
          {
            "kind": "text",
            "locator": "p. 35, Section 7.3",
            "quote": "This strategy offers distinct advantages in device integration and minimizing enzyme demand",
            "source": "scale:commons/source/10.1021-acs.chemrev.6c00095"
          }
        ],
        "inference_type": "meta_analysis",
        "origin": "reported",
        "scope": "Fdh-based semiartificial CO2 fixation",
        "statement": "Four decades after the first mediator-based semiartificial CO2 fixation with Fdh, research has shifted toward direct electron transfer, which eases device integration and lowers enzyme demand."
      }
    },
